# ---------------------------------------------------------------------------
# NEVER COMMIT. plsql_to_brd is a SEPARATE repository that happens to sit
# inside this working directory. It has its own .git, so `git add .` would
# either commit it as a broken submodule reference or pull its entire history
# in. Neither is recoverable cleanly once pushed. Do not remove this rule.
# ---------------------------------------------------------------------------
plsql_to_brd/
plsql-to-brd/

# Scratch pipeline output (ad-hoc -o out/ runs). Reproducible, not committed.
out/
output/

# Downloaded/cloned source repos to scan. Third-party code, not ours to
# redistribute, and easy to re-fetch — never commit it.
input/

# outputs/ IS committed (unlike out/ above) — it holds named, curated demo
# results (e.g. outputs/java_bank/) meant to be pushed and shown.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
